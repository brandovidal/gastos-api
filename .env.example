NODE_ENV="dev"
PORT=5560
LOG_LEVEL=

# REST API key used by kogane-app (header x-api-key)
API_KEY=

# Database: local SQLite
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# AI extraction
AI_TIMEOUT_MS=20000
AI_TEXT_PRIMARY=groq
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT=20
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_DAILY_LIMIT=1000
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_DAILY_LIMIT=2000

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
PUBLIC_URL=

# Screenshots and voice notes (D54). Without R2 keys they go to STORAGE_LOCAL_DIR (local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kogane-captures
STORAGE_LOCAL_DIR=.data/storage
