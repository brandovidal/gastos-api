NODE_ENV="dev"
PORT=5560
LOG_LEVEL=

# REST API key used by gastos-app (header x-api-key)
API_KEY=

# Database: local SQLite (file:./dev.db) or Turso (libsql://<db>-<org>.turso.io)
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# Pending (see docs/plans): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_ALLOWED_CHAT_IDS,
# AI_PROVIDER, GEMINI_API_KEY, OPENROUTER_API_KEY
