NODE_ENV="dev"
PORT=5560
LOG_LEVEL=

# REST API key used by kogane-app (header x-api-key)
API_KEY=

# Database: local SQLite (file:./dev.db) or Turso (libsql://<db>-<org>.turso.io)
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# AI extraction: Gemini (primary, free tier) and Groq (Qwen fallback, free tier)
AI_TIMEOUT_MS=20000
# Primary model for text: groq (Qwen first, default) or gemini (Flash-Lite first). Images always use Gemini
AI_TEXT_PRIMARY=groq
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT=20
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_DAILY_LIMIT=1000

# Telegram bot (see docs/plans section 3): token from @BotFather, secret from `openssl rand -hex 32`,
# chat ids allowed to use the bot (comma separated). Webhook URL for `pnpm telegram:setup`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
PUBLIC_URL=

# Voice notes (P5): Whisper on Groq, same GROQ_API_KEY
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_DAILY_LIMIT=2000
