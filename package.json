{
  "name": "gastos-api",
  "version": "0.0.1",
  "description": "Gastos API: expense intake from chat with AI",
  "author": "Brando Vidal",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e .env.dev -- nest start --watch",
    "start": "nest start",
    "start:debug": "dotenv -e .env.dev -- nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "pnpm run test:unit",
    "test:ui": "pnpm run test:unit --ui",
    "test:ci": "dotenv -e .env.test -- vitest run --project unit",
    "test:cov": "dotenv -e .env.test -- vitest run --project unit --coverage",
    "test:unit": "dotenv -e .env.test -- vitest --project unit",
    "test:integration": "dotenv -e .env.test -- vitest --project integration",
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "db:migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "db:studio": "dotenv -e .env.dev -- prisma studio",
    "postinstall": "prisma generate",
    "clean": "rimraf node_modules/ dist/ coverage/ src/generated/",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.2.1",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.4.2"
}
